# ORM's MCP server (docs/mcp/MCP.md, section 12). Copy to mcp_server/.env (mode 600); systemd reads it
# (deploy/orm-mcp.service). No secret belongs here: only where Rails is and Durian OS's public keys.
ORM_API_URL=http://127.0.0.1:3000
ORM_ACCOUNT_ID=1
HOST=127.0.0.1
PORT=8432
MCP_ALLOWED_HOSTS=orm.durianos.in
# A copy of the OS_JWKS_JSON line of chatwoot/.env (Durian OS's public keys); copy it again whenever it changes there.
# OS_JWKS_JSON=
# OS_ISSUER=https://durianos.in
